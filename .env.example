# Local development examples are public; never commit production secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=
DATABASE_MIGRATION_URL=
WEB_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Values below exclusively in your secret manager / one-time operator shell:
IDENTITY_ENCRYPTION_KEY=
CAREGANGA_ROOT_NAME=
CAREGANGA_ROOT_MOBILE=
CAREGANGA_ROOT_EMAIL=
CAREGANGA_ROOT_PASSWORD=
# Forgot Password requires configured SMTP email OR Twilio SMS OTP; both are optional at setup,
# but a real provider must be available before enabling recovery for that destination.
# For SMTP, all four email variables are required together.
AUTH_SMTP_HOST=
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=
# SMS OTP provider (Twilio); only for password recovery, not registration/login.
AUTH_SMS_TWILIO_ACCOUNT_SID=
AUTH_SMS_TWILIO_AUTH_TOKEN=
AUTH_SMS_TWILIO_FROM=

# CG-01 FR-081: optional ERP deployment requests, inert until respective owner modules ship.
# Never store real partner/center entitlements in .env; only lowercase true/false accepted.
CAREGANGA_ERP_LAB_ENABLED=false
CAREGANGA_ERP_PHARMACY_ENABLED=false
CAREGANGA_ERP_NURSING_ENABLED=false
CAREGANGA_ERP_OT_ENABLED=false

# CG-19 US-003: optional signed guest-address bridge, set BOTH for production.
# Use an independent shared 32-byte base64 secret in Web and Backend secret stores.
# Trusted ingress MUST strip user-supplied header and set this from actual client IP;
# do not trust raw X-Forwarded-For from arbitrary visitors.
CG19_GUEST_PROXY_KEY=
CG19_TRUSTED_CLIENT_IP_HEADER=

# Public Android contact uses the Next Web guest gateway, never the backend
# secret-signing key. Must be HTTPS for production and match the Web deployment.
EXPO_PUBLIC_CONTACT_WEB_ORIGIN=http://localhost:3000

# Verified public site origin for approved CMS sitemap, e.g. https://your-domain.example/
PUBLIC_SITE_ORIGIN=

# CG-15 patient registration: required owner-approved versioned patient-care consent.
# Keep values blank until genuine approved patient-consent wording is supplied.
# Do not invent legal language or allow registration without it.
CG15_PATIENT_CONSENT_VERSION=
CG15_PATIENT_CONSENT_TEXT=

# CG-15: operator-approved temporary consultation hold window (5-10 minutes).
# Blank disables booking. Do not activate until 1424 migration + real concurrency QA.
CG15_HOLD_MINUTES=

# CG-19: independent 32-byte base64 secret for status-only consultation QR
# set via secret manager; requires CG-19 secure storage and validated PDF font.
# Do not use IDENTITY_ENCRYPTION_KEY or a client-side/EXPO_PUBLIC key.
CG19_APPOINTMENT_QR_KEY=

# CG-15 optional patient consultation reason: separate backend-only AES-256-GCM
# 32-byte canonical base64 secret. Never expose to EXPO_PUBLIC/Web clients.
# Existing appointments without a private reason do NOT depend on this key.
# Set through secret manager before allowing patient-entered reasons.
CG15_BOOKING_REASON_KEY_BASE64=
# CG-15 original optional patient-owned emergency and medical context;
# a SEPARATE, backend-only canonical AES-256-GCM 32-byte base64 secret.
# Never EXPO_PUBLIC, never render in logs or third-party analytics.
CG15_PATIENT_DETAILS_KEY_BASE64=

# CG-01 mobile proof required for public patient signup and CG-15 patient ID.
# Use Twilio Verify, not password-login MFA. Keep disabled until configured.
CG01_PHONE_VERIFICATION_ENABLED=0
CG01_VERIFY_TWILIO_ACCOUNT_SID=
CG01_VERIFY_TWILIO_AUTH_TOKEN=
CG01_VERIFY_TWILIO_SERVICE_SID=
CG01_MOBILE_PROOF_HMAC_KEY=

# CG-15 patient-initiated cancel/reschedule cutoff: 0-1440 minutes before visit.
# Default 60 minutes when absent; no automatic refunds/penalties.
CG15_CHANGE_CUTOFF_MINUTES=60

# CG-12 restricted supplier contact encryption: independent 32-byte random base64 key; server only. Required only for protected supplier details.
CG12_SUPPLIER_ENCRYPTION_KEY=

# CG-04 / CG-19 original member card, certificate and welcome-letter issuance.
# Server-side ONLY; never use EXPO_PUBLIC or publish the QR HMAC secret.
# Independent 32 random bytes encoded in base64, set via deployment secret store.
# Never reuse the appointment QR, session, encryption or password keys.
CG19_MEMBER_QR_KEY=
# Absolute path to an operator-reviewed Unicode/OpenType font available to backend.
# Do not place third-party proprietary font binaries in the repository.
CG19_PDF_FONT_PATH=
# CG19 private storage/provider + scan verification: required before any issued pack.
# Use exactly FIREBASE or S3 and configure one private bucket with correct IAM.
# Issuance remains unavailable until a private storage provider, ClamAV and
# three approved real logo/signature/seal images are configured and verified.
CG19_STORAGE_PROVIDER=
CG19_CLAMAV_HOST=
CG19_CLAMAV_PORT=
CG19_FIREBASE_BUCKET=
CG19_FIREBASE_PROJECT_ID=
CG19_S3_BUCKET=
AWS_REGION=

# CG-13 reward images: backend-only public Web origin for CG19-approved,
# already-published CMS photos. HTTPS required. No trailing path, secret token,
# signed storage URL or generic third-party host accepted. Empty means no photos.
# Must match the origin serving /api/public/content/media/:fileRef.
# The original CG19 scanner, publication, image MIME/size, rights and SHA-256
# checks remain mandatory on every photo read, including after revocation.
CG13_PUBLIC_MEDIA_ORIGIN=
 
# CG13 optional public Android referral sharing link origin, not a secret.
# HTTPS canonical frontend origin (no path/credentials/query). If missing,
# native shares the opaque code as text, never a guessed deployment hostname.
# Backend remains the authority for CG04 eligibility; this value grants nothing.
EXPO_PUBLIC_PUBLIC_WEB_URL=

# CG13 anonymous referral-code eligibility checks. Backend ONLY:
# 32 random bytes in canonical base64, different from CG01 identity secrets.
# Needed before enabling public POST /api/v1/referrals/resolve; missing value
# deliberately fails closed. Store through backend secret manager, never EXPO_PUBLIC.
# HMAC protects request IP in bounded, non-identifying 15-min rate counters.
CG13_RESOLVE_HMAC_KEY_BASE64=

# Optional CG09 RazorpayX payroll READBACK (manual bank submission only, no POST API).
# Default OFF. Dedicated payout credentials, not CG07 donation credentials.
CG09_PAYROLL_RAZORPAYX_READBACK=0
CG09_PAYROLL_RAZORPAYX_ROOT=
CG09_PAYROLL_RAZORPAYX_BANK_REF=
CG09_PAYROLL_RAZORPAYX_ACCOUNT=
CG09_PAYROLL_RAZORPAYX_SECRET_REF=
CG09_PAYROLL_RAZORPAYX_KEY_ID=
CG09_PAYROLL_RAZORPAYX_KEY_SECRET=

# Optional outgoing payroll dispatch. Both flags default OFF; bank onboarding/signing, dedicated keys and protected current-password Finance release required.
CG09_PAYROLL_RAZORPAYX_DISPATCH=0
CG09_PAYROLL_RAZORPAYX_SIGNING_APPROVED=0
CG09_PAYROLL_RAZORPAYX_FEE_RESERVE_MINOR=
