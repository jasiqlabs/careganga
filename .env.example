# Only names and non-secret examples; never commit actual values.
NODE_ENV=development
PORT=4000
DATABASE_URL=
WEB_ORIGIN=http://localhost:3000
# A distinct direct, non-transaction-pooled URL is required for migrations.
DATABASE_MIGRATION_URL=
# Bootstrap is an explicit, one-time local operator command. Never set real values in committed files.
CAREGANGA_ROOT_NAME=
CAREGANGA_ROOT_EMAIL=
CAREGANGA_ROOT_PASSWORD=
# 32 random bytes encoded in base64; encryption key for root TOTP secret at rest.
IDENTITY_ENCRYPTION_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
