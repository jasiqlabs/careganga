    "test:cg12-all": "tsx --test test/cg12-catalog-contract.test.ts test/cg12-stock-contract.test.ts",
    "test:cg13-us001": "tsx --test test/cg13-us001-catalogue-validation.test.ts test/cg13-us001-scope-contract.test.ts",
