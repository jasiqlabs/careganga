{
  "name": "careganga",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w apps/backend",
    "dev:web": "npm run dev -w apps/web",
    "start:android-public": "npm run start -w apps/android-public",
    "start:android-internal": "npm run start -w apps/android-internal",
    "db:migrate": "npm run db:migrate -w apps/backend",
    "verify:auth-source": "node scripts/verify-greenfield-auth.mjs",
    "verify:design-approvals": "node scripts/verify-design-approvals.mjs",
    "deploy:cms:first": "node scripts/deploy-cms-first-publication.mjs",
    "verify:cms:first": "node --test scripts/verify-cms-first-publication.test.mjs scripts/deploy-cms-first-publication.test.mjs",
    "verify:cg18-source": "node scripts/verify-cg18-us001-source.mjs",
    "verify:core-source": "node scripts/verify-cg-core-source.mjs",
    "verify:cg14-source": "node scripts/verify-cg14-source.mjs",
    "verify:cg14-us004-us005-source": "node scripts/verify-cg14-us004-us005-source.mjs",
    "verify:cg15-us001-source": "node scripts/verify-cg15-us001-source.mjs",
    "verify:cg15-us002-source": "node scripts/verify-cg15-us002-source.mjs",
    "verify:cg15-us003-source": "node scripts/verify-cg15-us003-source.mjs",
    "verify:cg15-us004-us008-source": "node scripts/verify-cg15-us004-us008-source.mjs",
    "verify:cg15-migrations-source": "node scripts/verify-cg15-migrations-source.mjs",
    "verify:cg15-communications-source": "node scripts/verify-cg15-communications-source.mjs",
    "verify:cg15-clinician-source": "node scripts/verify-cg15-clinician-source.mjs",
    "verify:cg15-private-purpose-source": "node scripts/verify-cg15-private-purpose-source.mjs",
    "verify:cg15-native-documents-source": "node scripts/verify-cg15-native-documents-source.mjs",
    "verify:cg15-patient-files-source": "node scripts/verify-cg15-patient-files-source.mjs",
    "verify:cg15-patient-private-details-source": "node scripts/verify-cg15-patient-private-details-source.mjs",
    "verify:cg15-patient-clinical-sharing-source": "node scripts/verify-cg15-patient-clinical-sharing-source.mjs",
    "verify:cg15-patient-access-isolation-source": "node scripts/verify-cg15-patient-access-isolation-source.mjs",
    "verify:cg15-final-source-gaps": "node scripts/verify-cg15-final-source-gaps.mjs",
    "verify:cg01-uiux-source": "node scripts/verify-cg01-uiux-source.mjs",
    "verify:cg16-us001-source": "node scripts/verify-cg16-us001-source.mjs",
    "verify:cg16-us002-source": "node scripts/verify-cg16-us002-source.mjs",
    "verify:healthcare-journeys-source": "node scripts/verify-healthcare-journeys-source.mjs",
    "verify:healthcare-public-reference-source": "node scripts/verify-healthcare-public-reference-source.mjs",
    "verify:cg16-us005-source": "node scripts/verify-cg16-us005-source.mjs",
    "verify:cg17-us007-source": "node scripts/verify-cg17-us007-source.mjs",
    "verify:cg17-us003-source": "node scripts/verify-cg17-us003-source.mjs",
    "verify:cg17-us004-source": "node scripts/verify-cg17-us004-source.mjs",
    "verify:cg17-us005-source": "node scripts/verify-cg17-us005-source.mjs",
    "verify:cg17-us006-source": "node scripts/verify-cg17-us006-source.mjs",
    "verify:cg16-us003-source": "node scripts/verify-cg16-us003-source.mjs",
    "verify:cg16-us004-source": "node scripts/verify-cg16-us004-source.mjs",
    "verify:cg19-client-source": "node scripts/verify-cg19-client-source.mjs",
    "verify:cg21-source": "node scripts/verify-cg21-source.mjs",
    "verify:cg20-source": "node scripts/verify-cg20-source.mjs",
    "verify:migration-history-source": "node scripts/verify-migration-history-source.mjs",
    "verify:local-source-preflight": "npm run verify:all-source",
    "build:backend": "npm run build -w apps/backend",
    "build:web": "npm run build -w apps/web",
    "typecheck:android-internal": "tsc --noEmit -p apps/android-internal/tsconfig.json",
    "typecheck:android-public": "tsc --noEmit -p apps/android-public/tsconfig.json",
    "verify:local-build": "npm run build:backend && npm run build:web && npm run typecheck:android-internal && npm run typecheck:android-public",
    "verify:all-source": "node scripts/run-local-source-checks.mjs",
    "verify:cg14-partner-first-source": "node scripts/verify-cg14-partner-first-source.mjs",
    "postinstall": "node scripts/patch-typescript-runtime.mjs",
    "verify:healthcare-safe-errors-source": "node scripts/verify-healthcare-safe-error-coverage.mjs",
    "verify:cg17-erp-off-policy-source": "node scripts/verify-cg17-erp-off-policy-source.mjs",
    "verify:cg17-erp-off-claim-source": "node scripts/verify-cg17-erp-off-claim-source.mjs",
    "verify:cg17-verified-partner-finance-source": "node scripts/verify-cg17-verified-partner-finance-source.mjs",
    "verify:cg14-erp-off-partner-catalog-source": "node scripts/verify-cg14-erp-off-partner-catalog-source.mjs",
    "db:baseline:generate": "npm run db:baseline:generate -w apps/backend",
    "db:init": "npm run db:init -w apps/backend --",
    "db:upgrade": "npm run db:upgrade -w apps/backend",
    "db:release:check": "npm run db:release:check -w apps/backend",
    "verify:db:baseline": "npm run test:db:baseline -w apps/backend"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.15.30"
  }
}
