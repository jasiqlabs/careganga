# Local development examples are public; never commit production secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=
DATABASE_MIGRATION_URL=
WEB_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Values below exclusively in your secret manager / one-time operator shell:
IDENTITY_ENCRYPTION_KEY=
CAREGANGA_ROOT_NAME=
CAREGANGA_ROOT_EMAIL=
CAREGANGA_ROOT_PASSWORD=
CAREGANGA_ROOT_TOTP_BASE32=
CAREGANGA_ROOT_TOTP_PROOF=
# Optional until account recovery delivery is enabled: all four are required as a set.
AUTH_SMTP_HOST=
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=

# CG-01 FR-081: optional ERP deployment requests, inert until respective owner modules ship.
# Never store real partner/center entitlements in .env; only lowercase true/false accepted.
CAREGANGA_ERP_LAB_ENABLED=false
CAREGANGA_ERP_PHARMACY_ENABLED=false
CAREGANGA_ERP_NURSING_ENABLED=false
CAREGANGA_ERP_OT_ENABLED=false
