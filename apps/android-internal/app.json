{
  "expo": {
    "name": "CareGanga Internal",
    "slug": "careganga-internal",
    "scheme": "careganga-internal",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "android": {
      "package": "org.careganga.foundation.internal",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
