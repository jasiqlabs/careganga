    "test:cg20-multibranch-scope-db": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs --test test/cg20-multibranch-scope-db-integrity.test.ts",
    "test:cg08-partner": "tsx --test test/cg08-partner-contract.test.ts",
    "test:cg08-db-integrity": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs --test test/cg08-db-integrity.test.ts",
