{
  "name": "@careganga/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsc -p tsconfig.json && node --watch --env-file=.env dist/src/main.js",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs db/migrate.ts",
    "bootstrap:root": "node --env-file=.env ../../node_modules/tsx/dist/cli.mjs src/modules/cg-01-identity-access/infrastructure/bootstrap-root.ts",
    "test:cg20-source-contracts": "tsx --test test/cg20-source-contract.test.ts",
    "test:cg10-enrollment": "tsx --test test/cg10-enrollment-contract.test.ts",
    "test:cg10-attendance": "tsx --test test/cg10-attendance-contract.test.ts",
    "test:cg10-appraisal": "tsx --test test/cg10-appraisal-contract.test.ts",
    "test:cg10-employment-change": "tsx --test test/cg10-employment-change-contract.test.ts",
    "test:cg12-catalog": "tsx --test test/cg12-catalog-contract.test.ts",
    "test:cg10-all": "tsx --test test/cg10-enrollment-contract.test.ts test/cg10-attendance-contract.test.ts test/cg10-appraisal-contract.test.ts test/cg10-employment-change-contract.test.ts test/cg10-document-allowance-contract.test.ts test/cg19-migration-compatibility.test.ts",
    "test:cg10-document-allowance": "tsx --test test/cg10-document-allowance-contract.test.ts",
    "test:cg19-migration-compatibility": "tsx --test test/cg19-migration-compatibility.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "pg": "8.16.3",
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@google-cloud/storage": "8.4.0",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "nodemailer": "10.5.0"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "@types/pg": "8.15.5",
    "@types/express": "5.0.3"
  }
}
